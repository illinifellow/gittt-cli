{
  "name": "gittt-cli",
  "version": "0.1.1",
  "description": "A git browser for the terminal: a catalogue of every repository under a folder, a commit graph, files and highlighted diffs, dialogs for every action and full mouse support.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gittt": "dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/illinifellow/gittt-cli.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "shiki": "^4.5.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "cli",
    "git-gui",
    "git-graph",
    "git-log",
    "ink",
    "mouse"
  ],
  "author": "illinifellow",
  "homepage": "https://github.com/illinifellow/gittt-cli#readme",
  "bugs": {
    "url": "https://github.com/illinifellow/gittt-cli/issues"
  }
}
